# ── Trading mode ──────────────────────────────────────────────────────────
# Paper by default. Live trading requires BOTH of the following:
TRADING_MODE=paper          # paper | live
ENABLE_LIVE_TRADING=0       # must be 1 (and mode=live) to send real orders

# Hybrid validation: REAL Robinhood market data, SIMULATED fills (no real
# orders). Needs Robinhood creds below and is subject to market hours.
LIVE_MARKET_DATA=0          # 1 = real quotes + paper execution

# ── Paper account ─────────────────────────────────────────────────────────
PAPER_STARTING_CASH=100000

# ── Risk limits (hard constraints, enforced in code) ──────────────────────
MAX_POSITION_PCT=0.20            # max single position as fraction of equity
MAX_ORDER_VALUE=5000             # absolute per-order notional cap (USD)
STOP_LOSS_PCT=0.05               # per-position stop loss
DAILY_DRAWDOWN_LIMIT_PCT=0.03    # trips the kill switch when breached
MIN_CONFIDENCE=0.55              # minimum model confidence to approve a trade
MAX_OPEN_POSITIONS=10

# ── Robinhood credentials (LIVE mode only) ────────────────────────────────
ROBINHOOD_USERNAME=
ROBINHOOD_PASSWORD=
ROBINHOOD_MFA=

# ── Optional ──────────────────────────────────────────────────────────────
# TRADING_DATA_DIR=./data
# TRADING_SESSION_ID=
